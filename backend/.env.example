# Teman Mancing - Backend Environment Configuration Example
APP_ENV=development
APP_PORT=8080

# PostgreSQL Connection
DATABASE_URL=postgres://teman_mancing_user:teman_mancing_secret@postgres:5432/teman_mancing?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=teman_mancing_user
DB_PASSWORD=teman_mancing_secret
DB_NAME=teman_mancing
DB_SSLMODE=disable

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-teman-mancing-min-32-chars-long
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminsecret
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_SPOTS=fishing-spots
MINIO_BUCKET_EVENTS=event-covers

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Redis Cache / PubSub
REDIS_URL=redis://redis:6379
