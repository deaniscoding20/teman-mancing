# Teman Mancing - Docker Compose Environment
POSTGRES_USER=teman_mancing_user
POSTGRES_PASSWORD=teman_mancing_secret
POSTGRES_DB=teman_mancing
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_SPOTS=fishing-spots
MINIO_BUCKET_EVENTS=event-covers

BACKEND_PORT=8080
FRONTEND_PORT=3003

# URLs for Frontend Client Access (Set to VPS IP or Domain)
NEXT_PUBLIC_API_URL=https://temanmancing.my.id/api/v1
NEXT_PUBLIC_WS_URL=wss://temanmancing.my.id/ws

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://temanmancing.my.id,https://www.temanmancing.my.id,http://temanmancing.my.id,http://localhost:3003,http://127.0.0.1:3003,http://43.173.39.59:3003,http://localhost:3000,http://127.0.0.1:3000

JWT_SECRET=super-secret-jwt-key-teman-mancing-min-32-chars-long
